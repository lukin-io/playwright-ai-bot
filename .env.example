# Copy this file to `.env` and fill in your secrets.

# NEVERLANDS account credentials (do NOT commit real values)
NEVERLANDS_USERNAME=your_login
NEVERLANDS_PASSWORD=your_password

# OpenAI API key (from https://platform.openai.com/)
# Example format: sk-proj-***************************************
OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides
NEVERLANDS_LOGIN_URL=http://www.neverlands.ru/
NEVERLANDS_HOME_URL=http://www.neverlands.ru/game.php
NEVERLANDS_USERNAME_SELECTOR=input[name='player_nick']
NEVERLANDS_PASSWORD_SELECTOR=#real
NEVERLANDS_SUBMIT_SELECTOR=#ent_button
OPENAI_MODEL=gpt-5.1
USE_SCREENSHOTS=true
